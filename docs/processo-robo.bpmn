<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_caminho_livre" targetNamespace="https://github.com/caminho-livre/rpa" exporter="caminho-livre-rpa" exporterVersion="1.0">
  <bpmn:error id="erro_indisponivel" name="ServicoIndisponivel" errorCode="SERVICO_INDISPONIVEL" />
  <bpmn:process id="robo_caminho_livre" name="Robô Caminho Livre: importação e triagem" isExecutable="false">
    <bpmn:startEvent id="inicio" name="Agendado (GitHub Actions) ou manual"><bpmn:outgoing>f_inicio_verificar</bpmn:outgoing><bpmn:timerEventDefinition id="timer_hora"><bpmn:timeCycle>R/PT1H</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
    <bpmn:serviceTask id="verificar" name="Verificar MVP no ar (GET /health)"><bpmn:incoming>f_inicio_verificar</bpmn:incoming><bpmn:outgoing>f_verificar_gw_mvp</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_mvp" name="MVP no ar?"><bpmn:incoming>f_verificar_gw_mvp</bpmn:incoming><bpmn:outgoing>f_gw_mvp_ler_mvp</bpmn:outgoing><bpmn:outgoing>f_gw_mvp_falha</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="falha" name="Registrar FALHA e avisar gestor"><bpmn:incoming>f_gw_mvp_falha</bpmn:incoming><bpmn:outgoing>f_falha_fim_falha</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="fim_falha" name="Execução em FALHA"><bpmn:incoming>f_falha_fim_falha</bpmn:incoming><bpmn:errorEventDefinition id="def_fim_falha" errorRef="erro_indisponivel" /></bpmn:endEvent>
    <bpmn:serviceTask id="ler_mvp" name="Ler território e relatos (API do MVP)"><bpmn:incoming>f_gw_mvp_ler_mvp</bpmn:incoming><bpmn:outgoing>f_ler_mvp_gw_arquivo</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_arquivo" name="Há arquivo na entrada?"><bpmn:incoming>f_ler_mvp_gw_arquivo</bpmn:incoming><bpmn:incoming>f_merge_arq_gw_arquivo</bpmn:incoming><bpmn:outgoing>f_gw_arquivo_abrir</bpmn:outgoing><bpmn:outgoing>f_gw_arquivo_merge_triagem</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="abrir" name="Abrir próximo arquivo CSV"><bpmn:incoming>f_gw_arquivo_abrir</bpmn:incoming><bpmn:outgoing>f_abrir_gw_csv</bpmn:outgoing><bpmn:standardLoopCharacteristics id="loop_abrir" /></bpmn:task>
    <bpmn:exclusiveGateway id="gw_csv" name="CSV válido?"><bpmn:incoming>f_abrir_gw_csv</bpmn:incoming><bpmn:outgoing>f_gw_csv_validar</bpmn:outgoing><bpmn:outgoing>f_gw_csv_quarentena</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="quarentena" name="Mover para quarentena com motivo"><bpmn:incoming>f_gw_csv_quarentena</bpmn:incoming><bpmn:outgoing>f_quarentena_merge_arq</bpmn:outgoing></bpmn:task>
    <bpmn:task id="validar" name="Ler próxima linha, validar e normalizar"><bpmn:incoming>f_gw_csv_validar</bpmn:incoming><bpmn:incoming>f_gw_mais_linhas_validar</bpmn:incoming><bpmn:outgoing>f_validar_gw_linha</bpmn:outgoing><bpmn:standardLoopCharacteristics id="loop_validar" /></bpmn:task>
    <bpmn:exclusiveGateway id="gw_linha" name="Linha válida e no território?"><bpmn:incoming>f_validar_gw_linha</bpmn:incoming><bpmn:outgoing>f_gw_linha_lgpd</bpmn:outgoing><bpmn:outgoing>f_gw_linha_rejeitar</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="rejeitar" name="Registrar rejeição com motivo"><bpmn:incoming>f_gw_linha_rejeitar</bpmn:incoming><bpmn:outgoing>f_rejeitar_gw_mais_linhas</bpmn:outgoing></bpmn:task>
    <bpmn:task id="lgpd" name="Remover dados pessoais (LGPD)"><bpmn:incoming>f_gw_linha_lgpd</bpmn:incoming><bpmn:outgoing>f_lgpd_gw_dup</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="gw_dup" name="Duplicata ou já importada?"><bpmn:incoming>f_lgpd_gw_dup</bpmn:incoming><bpmn:outgoing>f_gw_dup_criar</bpmn:outgoing><bpmn:outgoing>f_gw_dup_duplicata</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="duplicata" name="Registrar duplicata"><bpmn:incoming>f_gw_dup_duplicata</bpmn:incoming><bpmn:outgoing>f_duplicata_gw_mais_linhas</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="criar" name="Criar relato (POST /api/reports)"><bpmn:incoming>f_gw_dup_criar</bpmn:incoming><bpmn:outgoing>f_criar_gw_mais_linhas</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="manter" name="Manter arquivo para nova tentativa"><bpmn:incoming>f_erro_criar_manter</bpmn:incoming><bpmn:outgoing>f_manter_fim_falha2</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="fim_falha2" name="Importação interrompida"><bpmn:incoming>f_manter_fim_falha2</bpmn:incoming><bpmn:errorEventDefinition id="def_fim_falha2" errorRef="erro_indisponivel" /></bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_mais_linhas" name="Mais linhas?"><bpmn:incoming>f_rejeitar_gw_mais_linhas</bpmn:incoming><bpmn:incoming>f_duplicata_gw_mais_linhas</bpmn:incoming><bpmn:incoming>f_criar_gw_mais_linhas</bpmn:incoming><bpmn:outgoing>f_gw_mais_linhas_validar</bpmn:outgoing><bpmn:outgoing>f_gw_mais_linhas_processados</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="processados" name="Mover arquivo para processados"><bpmn:incoming>f_gw_mais_linhas_processados</bpmn:incoming><bpmn:outgoing>f_processados_merge_arq</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="merge_arq" name=""><bpmn:incoming>f_quarentena_merge_arq</bpmn:incoming><bpmn:incoming>f_processados_merge_arq</bpmn:incoming><bpmn:outgoing>f_merge_arq_gw_arquivo</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="merge_triagem" name=""><bpmn:incoming>f_gw_arquivo_merge_triagem</bpmn:incoming><bpmn:outgoing>f_merge_triagem_fatores</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="fatores" name="Consultar chuva e locais sensíveis"><bpmn:incoming>f_merge_triagem_fatores</bpmn:incoming><bpmn:outgoing>f_fatores_priorizar</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="degradar" name="Usar cache/snapshot ou seguir sem o fator"><bpmn:incoming>f_erro_fatores_degradar</bpmn:incoming><bpmn:outgoing>f_degradar_priorizar</bpmn:outgoing></bpmn:task>
    <bpmn:task id="priorizar" name="Priorizar próximo relato aberto"><bpmn:incoming>f_fatores_priorizar</bpmn:incoming><bpmn:incoming>f_degradar_priorizar</bpmn:incoming><bpmn:incoming>f_gw_mais_relatos_priorizar</bpmn:incoming><bpmn:outgoing>f_priorizar_gw_alta</bpmn:outgoing><bpmn:standardLoopCharacteristics id="loop_priorizar" /></bpmn:task>
    <bpmn:exclusiveGateway id="gw_alta" name="ALTA e pendente?"><bpmn:incoming>f_priorizar_gw_alta</bpmn:incoming><bpmn:outgoing>f_gw_alta_em_analise</bpmn:outgoing><bpmn:outgoing>f_gw_alta_merge_alta</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="em_analise" name="Mudar para em análise (PATCH)"><bpmn:incoming>f_gw_alta_em_analise</bpmn:incoming><bpmn:outgoing>f_em_analise_merge_alta</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="merge_alta" name=""><bpmn:incoming>f_gw_alta_merge_alta</bpmn:incoming><bpmn:incoming>f_em_analise_merge_alta</bpmn:incoming><bpmn:outgoing>f_merge_alta_gw_mais_relatos</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_mais_relatos" name="Mais relatos?"><bpmn:incoming>f_merge_alta_gw_mais_relatos</bpmn:incoming><bpmn:outgoing>f_gw_mais_relatos_priorizar</bpmn:outgoing><bpmn:outgoing>f_gw_mais_relatos_gravar</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="gravar" name="Gravar fila, indicadores e resumo"><bpmn:incoming>f_gw_mais_relatos_gravar</bpmn:incoming><bpmn:outgoing>f_gravar_gw_houve_alta</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="gw_houve_alta" name="Houve ALTA?"><bpmn:incoming>f_gravar_gw_houve_alta</bpmn:incoming><bpmn:outgoing>f_gw_houve_alta_notificar</bpmn:outgoing><bpmn:outgoing>f_gw_houve_alta_fim</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="notificar" name="Notificar gestor (ntfy, se configurado)"><bpmn:incoming>f_gw_houve_alta_notificar</bpmn:incoming><bpmn:outgoing>f_notificar_fim</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="fim" name="Fila do gestor atualizada"><bpmn:incoming>f_gw_houve_alta_fim</bpmn:incoming><bpmn:incoming>f_notificar_fim</bpmn:incoming></bpmn:endEvent>
    <bpmn:boundaryEvent id="erro_criar" name="MVP fora após 3 tentativas" attachedToRef="criar"><bpmn:outgoing>f_erro_criar_manter</bpmn:outgoing><bpmn:errorEventDefinition id="def_erro_criar" errorRef="erro_indisponivel" /></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="erro_fatores" name="Fonte externa fora" attachedToRef="fatores"><bpmn:outgoing>f_erro_fatores_degradar</bpmn:outgoing><bpmn:errorEventDefinition id="def_erro_fatores" errorRef="erro_indisponivel" /></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="f_inicio_verificar" name="" sourceRef="inicio" targetRef="verificar" />
    <bpmn:sequenceFlow id="f_verificar_gw_mvp" name="" sourceRef="verificar" targetRef="gw_mvp" />
    <bpmn:sequenceFlow id="f_gw_mvp_ler_mvp" name="sim" sourceRef="gw_mvp" targetRef="ler_mvp" />
    <bpmn:sequenceFlow id="f_gw_mvp_falha" name="não" sourceRef="gw_mvp" targetRef="falha" />
    <bpmn:sequenceFlow id="f_falha_fim_falha" name="" sourceRef="falha" targetRef="fim_falha" />
    <bpmn:sequenceFlow id="f_ler_mvp_gw_arquivo" name="" sourceRef="ler_mvp" targetRef="gw_arquivo" />
    <bpmn:sequenceFlow id="f_gw_arquivo_abrir" name="sim" sourceRef="gw_arquivo" targetRef="abrir" />
    <bpmn:sequenceFlow id="f_gw_arquivo_merge_triagem" name="não" sourceRef="gw_arquivo" targetRef="merge_triagem" />
    <bpmn:sequenceFlow id="f_abrir_gw_csv" name="" sourceRef="abrir" targetRef="gw_csv" />
    <bpmn:sequenceFlow id="f_gw_csv_validar" name="sim" sourceRef="gw_csv" targetRef="validar" />
    <bpmn:sequenceFlow id="f_gw_csv_quarentena" name="não" sourceRef="gw_csv" targetRef="quarentena" />
    <bpmn:sequenceFlow id="f_quarentena_merge_arq" name="" sourceRef="quarentena" targetRef="merge_arq" />
    <bpmn:sequenceFlow id="f_validar_gw_linha" name="" sourceRef="validar" targetRef="gw_linha" />
    <bpmn:sequenceFlow id="f_gw_linha_lgpd" name="sim" sourceRef="gw_linha" targetRef="lgpd" />
    <bpmn:sequenceFlow id="f_gw_linha_rejeitar" name="não" sourceRef="gw_linha" targetRef="rejeitar" />
    <bpmn:sequenceFlow id="f_rejeitar_gw_mais_linhas" name="" sourceRef="rejeitar" targetRef="gw_mais_linhas" />
    <bpmn:sequenceFlow id="f_lgpd_gw_dup" name="" sourceRef="lgpd" targetRef="gw_dup" />
    <bpmn:sequenceFlow id="f_gw_dup_criar" name="não" sourceRef="gw_dup" targetRef="criar" />
    <bpmn:sequenceFlow id="f_gw_dup_duplicata" name="sim" sourceRef="gw_dup" targetRef="duplicata" />
    <bpmn:sequenceFlow id="f_duplicata_gw_mais_linhas" name="" sourceRef="duplicata" targetRef="gw_mais_linhas" />
    <bpmn:sequenceFlow id="f_criar_gw_mais_linhas" name="" sourceRef="criar" targetRef="gw_mais_linhas" />
    <bpmn:sequenceFlow id="f_erro_criar_manter" name="" sourceRef="erro_criar" targetRef="manter" />
    <bpmn:sequenceFlow id="f_manter_fim_falha2" name="" sourceRef="manter" targetRef="fim_falha2" />
    <bpmn:sequenceFlow id="f_gw_mais_linhas_validar" name="sim" sourceRef="gw_mais_linhas" targetRef="validar" />
    <bpmn:sequenceFlow id="f_gw_mais_linhas_processados" name="não" sourceRef="gw_mais_linhas" targetRef="processados" />
    <bpmn:sequenceFlow id="f_processados_merge_arq" name="" sourceRef="processados" targetRef="merge_arq" />
    <bpmn:sequenceFlow id="f_merge_arq_gw_arquivo" name="" sourceRef="merge_arq" targetRef="gw_arquivo" />
    <bpmn:sequenceFlow id="f_merge_triagem_fatores" name="" sourceRef="merge_triagem" targetRef="fatores" />
    <bpmn:sequenceFlow id="f_fatores_priorizar" name="" sourceRef="fatores" targetRef="priorizar" />
    <bpmn:sequenceFlow id="f_erro_fatores_degradar" name="" sourceRef="erro_fatores" targetRef="degradar" />
    <bpmn:sequenceFlow id="f_degradar_priorizar" name="" sourceRef="degradar" targetRef="priorizar" />
    <bpmn:sequenceFlow id="f_priorizar_gw_alta" name="" sourceRef="priorizar" targetRef="gw_alta" />
    <bpmn:sequenceFlow id="f_gw_alta_em_analise" name="sim" sourceRef="gw_alta" targetRef="em_analise" />
    <bpmn:sequenceFlow id="f_gw_alta_merge_alta" name="não" sourceRef="gw_alta" targetRef="merge_alta" />
    <bpmn:sequenceFlow id="f_em_analise_merge_alta" name="" sourceRef="em_analise" targetRef="merge_alta" />
    <bpmn:sequenceFlow id="f_merge_alta_gw_mais_relatos" name="" sourceRef="merge_alta" targetRef="gw_mais_relatos" />
    <bpmn:sequenceFlow id="f_gw_mais_relatos_priorizar" name="sim" sourceRef="gw_mais_relatos" targetRef="priorizar" />
    <bpmn:sequenceFlow id="f_gw_mais_relatos_gravar" name="não" sourceRef="gw_mais_relatos" targetRef="gravar" />
    <bpmn:sequenceFlow id="f_gravar_gw_houve_alta" name="" sourceRef="gravar" targetRef="gw_houve_alta" />
    <bpmn:sequenceFlow id="f_gw_houve_alta_notificar" name="sim" sourceRef="gw_houve_alta" targetRef="notificar" />
    <bpmn:sequenceFlow id="f_gw_houve_alta_fim" name="não" sourceRef="gw_houve_alta" targetRef="fim" />
    <bpmn:sequenceFlow id="f_notificar_fim" name="" sourceRef="notificar" targetRef="fim" />
    <bpmn:textAnnotation id="nota_pessoa"><bpmn:text>Pessoa no circuito: o robô nunca marca "resolvido" nem "descartado". Só o gestor decide.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="assoc_nota" sourceRef="em_analise" targetRef="nota_pessoa" />
  </bpmn:process>
