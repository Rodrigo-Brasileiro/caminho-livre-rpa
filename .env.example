# Copie para .env e preencha. O .env nunca vai para o Git.
MVP_URL=https://caminholivre-gs.azurewebsites.net
# Token de gestor do MVP (o mesmo ADMIN_TOKEN do App Service). Sem ele o robô só prioriza, não muda status.
MVP_ADMIN_TOKEN=
# Opcional: tópico ntfy.sh para avisar o gestor (prioridade ALTA ou falha do robô)
NTFY_URL=
